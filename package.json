{
  "name": "kontororu-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:watch": "node scripts/generate-tokens.mjs --watch",
    "dev": "npm run tokens && NEXT_DIST_DIR=.next-dev next dev --turbopack",
    "build": "npm run tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset",
    "db:types": "./scripts/gen-types.sh",
    "env:local": "eval \"$(supabase status -o env)\" && printf 'NEXT_PUBLIC_SUPABASE_URL=%s\\nNEXT_PUBLIC_SUPABASE_ANON_KEY=%s\\nSUPABASE_SERVICE_ROLE_KEY=%s\\nNEXT_PUBLIC_APP_URL=http://localhost:3000\\n' \"$API_URL\" \"$ANON_KEY\" \"$SERVICE_ROLE_KEY\" > .env.local",
    "test:rls": "supabase test db",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "npm run test:rls && ./scripts/check-service-role-leak.sh",
    "test": "npm run test:unit && npm run test:security && npm run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
