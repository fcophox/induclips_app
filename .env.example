# Supabase — proyecto del entorno
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor únicamente. Bypassea RLS: nunca en código de cliente.
# `npm run test:security` falla si esta clave aparece en un componente
# marcado con "use client".
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces en los correos de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Almacenamiento (opcional) -------------------------------------
# Por defecto todo va a Supabase Storage. Estas variables sólo hacen falta
# cuando un espacio tiene `storage_provider = 'S3'` o `'R2'`.
#
# El proveedor se decide POR ARCHIVO (`media.provider`), así que activarlo en
# un cliente no rompe lo que ya subió: lo antiguo se sigue sirviendo desde
# Supabase mientras lo nuevo va al bucket externo.
#
# R2 no cobra egress. Si sirves muchas imágenes es la diferencia entre pagar
# tráfico y no pagarlo — y con `R2_PUBLIC_BASE_URL` las URLs dejan de ser
# firmadas, con lo que el navegador y el optimizador de Next las cachean sin
# la ventana de `lib/storage/factory`.

# S3_ENDPOINT=                 # opcional en AWS; obligatorio en gateways compatibles
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=          # base del CDN, si el bucket sirve contenido público

# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
